# 複製這個檔案成 .env 後修改內容（.env 不會被上傳到 GitHub）
#
# 伺服器監聽的埠號（預設 3000）
PORT=3000

# JWT 簽章金鑰 —— 非常重要！請改成一串很長、隨機、只有你知道的字。
# 產生方法（在有 Node 的電腦上執行）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 一旦上線就不要再改，改了會讓所有人被登出。
JWT_SECRET=請改成一串很長的隨機字串

# 建立第一個管理者帳號所需的口令(選填但建議設定)。
# 設定後,第一次開網頁建立管理者時必須輸入這個口令,避免空窗期被別人搶先建立。
SETUP_TOKEN=

# 放在反向代理(nginx / Cloudflare)後面時設成 1,登入限流才會依真實 IP 計算
# TRUST_PROXY=1

# 登入後多久要重新登入（預設 7 天）
JWT_EXPIRES_IN=7d

# SQLite 資料庫檔案位置（預設 data/scheduling.db）
DB_PATH=data/scheduling.db
